{
  "name": "my-sonicjs-app",
  "version": "1.0.0",
  "private": true,
  "description": "全国财税发票 SEO - Cloudflare Workers 一键部署",
  "type": "module",
  "scripts": {
    "build": "echo Cloudflare Workers build ready",
    "deploy": "npx wrangler deploy",
    "db:migrate": "npx wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply DB --remote",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sonicjs-cms/core": "3.0.0-beta.28",
    "wrangler": "^4.133.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
